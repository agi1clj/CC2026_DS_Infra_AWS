# Copy to bootstrap.env (git-ignored) to pre-answer bootstrap.sh, or let bootstrap.sh create it.
# After renaming a GitHub repository, change the name here and re-run ./bootstrap/bootstrap.sh:
# the OIDC trust and the GitHub variables are updated to the new name.
AWS_PROFILE=my-sso-profile
AWS_REGION=eu-central-1
GITHUB_OWNER=your-github-user
APPS_REPO=CC2026_LastName_FirstName_Apps
INFRA_REPO=CC2026_LastName_FirstName_Infra_AWS
STUDENT_INITIALS=agi
# false = no CloudFront, app served over plain HTTP (if CloudFront is blocked for a new account)
ENABLE_CDN=true
# Decided by bootstrap.sh on the first run; do not change by hand.
CREATE_GITHUB_OIDC_PROVIDER=
