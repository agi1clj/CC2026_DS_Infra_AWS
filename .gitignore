# Terraform working files
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Generated by bootstrap/bootstrap.sh (student-specific values; CI uses GitHub variables)
terraform.tfvars
*.auto.tfvars
backend.hcl
bootstrap/bootstrap.env

# Keep the provider lock files (they pin provider checksums for every platform)
!.terraform.lock.hcl

# OS / editors
.DS_Store
.idea/
.vscode/

# Built by Terraform (archive_file) from terraform/modules/data-pipeline/lambda/handler.py
*.zip

# P2: the 32 MB dataset comes from the course channel; never commit it
data/energy_readings.csv

# Python caches
__pycache__/
*.pyc
